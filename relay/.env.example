PORT=8080
RELAY_PUBLIC_URL=https://api.cheapbuddy.cc
DATABASE_URL=postgres://cheapbuddy_relay:change-me@postgres.internal/cheapbuddy_integration
REDIS_URL=redis://redis.internal:6379/0
SUB2API_INTERNAL_URL=http://sub2api.internal
NEWAPI_INTERNAL_URL=http://newapi.internal
SUB2API_RELAY_SERVICE_TOKEN=change-me
NEWAPI_ADMIN_TOKEN=change-me
RELAY_TOKEN_ENCRYPTION_KEY=change-me
RELAY_INTERNAL_ADMIN_TOKEN=change-me
RELAY_VERIFIED_MODELS="gpt-image-2,seedream,grok,qwen-image,nanobanana 2,seedance,minimax H3,MiniMax-H3,qwen video,kling,vidu,minimax,suno,doubao-seedance-2-0-mini-260615,mimo-v2.5-tts-voicedesign,fishaudio/voice-design-1,fishaudio/voice-clone,victor-upmeet/whisperx"
RELAY_RESERVATION_QUOTA_BY_MODEL={"gpt-image-2":100000,"seedream":100000,"grok":100000,"qwen-image":100000,"nanobanana 2":100000,"seedance":1000000,"minimax H3":1000000,"MiniMax-H3":1000000,"qwen video":1000000,"kling":1000000,"vidu":1000000,"minimax":100000,"suno":100000,"doubao-seedance-2-0-mini-260615":1000000,"mimo-v2.5-tts-voicedesign":100000,"fishaudio/voice-design-1":100000,"fishaudio/voice-clone":100000,"victor-upmeet/whisperx":100000}
RELAY_MEDIA_MULTIPLIER_BY_MODEL={"gpt-image-2":1.0,"seedream":1.0,"grok":1.0,"qwen-image":1.0,"nanobanana 2":1.0,"seedance":1.0,"minimax H3":1.0,"MiniMax-H3":1.0,"qwen video":1.0,"kling":1.0,"vidu":1.0,"minimax":1.0,"suno":1.0,"doubao-seedance-2-0-mini-260615":1.0,"mimo-v2.5-tts-voicedesign":1.0,"fishaudio/voice-design-1":1.0,"fishaudio/voice-clone":1.0,"victor-upmeet/whisperx":1.0}
RELAY_MEDIA_BILLING_MODE_BY_MODEL={"gpt-image-2":"paid","seedream":"paid","grok":"paid","qwen-image":"paid","nanobanana 2":"paid","seedance":"paid","minimax H3":"paid","MiniMax-H3":"paid","qwen video":"paid","kling":"paid","vidu":"paid","minimax":"paid","suno":"paid","doubao-seedance-2-0-mini-260615":"paid","mimo-v2.5-tts-voicedesign":"paid","fishaudio/voice-design-1":"paid","fishaudio/voice-clone":"paid","victor-upmeet/whisperx":"paid"}
# Keep audio paths in any deployment-specific RELAY_MEDIA_PATHS override.
RELAY_MEDIA_PATHS="/v1/images/generations,/v1/images/edits,/v1/images/tasks,/v1/videos,/v1/audio/speech,/v1/audio/transcriptions,/v1/audio/translations,/suno/submit/music,/suno/submit/lyrics,/suno/fetch"
